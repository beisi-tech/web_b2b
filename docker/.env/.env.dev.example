# Example configuration for development; copy to .env.dev and adjust as needed
ENV_FILE=.env/.env.dev

# Django settings
DJANGO_SECRET_KEY=replace_with_dev_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web-b2b-backend
DJANGO_LOG_LEVEL=INFO
DJANGO_INTERNAL_BASE_URL=http://web-b2b-backend

# Database settings
DB_HOST=mysql
DB_PORT=3306
DB_NAME=web_b2b
DB_USER=root
DB_PASSWORD=replace_with_dev_db_password
MYSQL_ROOT_PASSWORD=replace_with_dev_db_password

# Caddy settings
DOMAIN=:8524

# Base URL settings
BASE_HOST_URL=http://localhost:8524
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8524
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8524

# Next.js runtime settings
TEMPLATE_ID=001

# Gunicorn settings
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# Node settings
NODE_ENV=production
PORT=80
