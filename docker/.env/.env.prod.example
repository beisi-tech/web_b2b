# Example configuration for production; copy to .env.prod and adjust as needed
ENV_FILE=.env/.env.prod

# Django settings
DJANGO_SECRET_KEY=replace_with_prod_secret_key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=shop.example.com,web-b2b-backend
DJANGO_LOG_LEVEL=INFO
DJANGO_INTERNAL_BASE_URL=http://web-b2b-backend

# Database settings
DB_HOST=mysql
DB_PORT=3306
DB_NAME=web_b2b
DB_USER=root
DB_PASSWORD=replace_with_prod_db_password

# Base URL settings
BASE_HOST_URL=https://shop.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com

# Next.js public settings
NEXT_PUBLIC_BASE_URL=https://shop.example.com
NEXT_PUBLIC_DJANGO_BASE_URL=https://shop.example.com/api
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_IMAGE_DOMAINS=shop.example.com
NEXT_PUBLIC_TEMPLATE_ID=001

# Gunicorn settings
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# Node settings
NODE_ENV=production
PORT=80
